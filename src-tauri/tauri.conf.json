{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "null-launcher",
  "version": "0.2.1",
  "identifier": "me.null68.null-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "null-launcher",
        "width": 960,
        "height": 640,
        "minWidth": 940,
        "minHeight": 600,
        "maxWidth": 1600,
        "maxHeight": 1000,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
